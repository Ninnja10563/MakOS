From: MakOS Project <makos@localhost>
Subject: [PATCH] runtime: stage MakOS libc crate and use POSIX thread types

Cargo verifies checksums for Firefox's vendored Rust crates. Route libc through
a separately staged, reproducibly patched copy. Use pid_t for Chromium's POSIX
thread identifier.

diff --git a/Cargo.lock b/Cargo.lock
--- a/Cargo.lock
+++ b/Cargo.lock
@@ -3696,6 +3696,4 @@
 [[package]]
 name = "libc"
 version = "0.2.171"
-source = "registry+https://github.com/rust-lang/crates.io-index"
-checksum = "c19937216e9d3aa9956d9bb8dfc0b0c8beb6058fc4f7a4dc4d850edf86a237d6"

diff --git a/Cargo.toml b/Cargo.toml
--- a/Cargo.toml
+++ b/Cargo.toml
@@ -102,4 +102,7 @@ opt-level = 2
 opt-level = 2
 
 [patch.crates-io]
+# MakOS keeps a staged copy because Cargo verifies vendored source checksums.
+libc = { path = "../libc-makos" }
+
 # The build system doesn't want those to be used, but they are pulled anyways (because
diff --git a/ipc/chromium/src/base/platform_thread.h b/ipc/chromium/src/base/platform_thread.h
--- a/ipc/chromium/src/base/platform_thread.h
+++ b/ipc/chromium/src/base/platform_thread.h
@@ -25,7 +25,7 @@ typedef void* PlatformThreadHandle;  // HANDLE
 #  include <pthread.h>
 typedef pthread_t PlatformThreadHandle;
 #  if defined(XP_LINUX) || defined(XP_OPENBSD) || defined(XP_SOLARIS) || \
-      defined(__GLIBC__)
+      defined(__GLIBC__) || defined(__makos__)
 #    include <unistd.h>
 typedef pid_t PlatformThreadId;
 #  elif defined(__DragonFly__) || defined(XP_FREEBSD) || defined(XP_NETBSD)
