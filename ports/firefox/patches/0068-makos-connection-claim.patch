From: MakOS Project <makos@localhost>
Subject: [PATCH] net: trace claimed connection continuation without changing policy

Record historical claim provenance, never transaction ownership. Trace DNS/TLS
continuation through existing callbacks and connection reclamation. Preserve
first-channel admission and the existing shared 32+1 transaction attempt cap.
No URI capture, new references, retry, preference or qualification changes.

---
diff --git a/mfbt/MakOSRuntimeEvidence.h b/mfbt/MakOSRuntimeEvidence.h
--- a/mfbt/MakOSRuntimeEvidence.h
+++ b/mfbt/MakOSRuntimeEvidence.h
@@ -246,6 +246,41 @@
              : WriteTransactionRecord("manager-local", 13, 0, false, 0, 0, 0, false);
 }
 // END MakOS transaction diagnostics
+
+// BEGIN MakOS connection claim diagnostics
+// Historical claim provenance, never transaction ownership. Socket-thread only
+// once bits belong to the object; captured copies survive reentrant callbacks.
+struct ConnectionClaim {
+  uint64_t channel = 0;
+  uint32_t token = 0;
+  uint32_t observed = 0;
+
+  bool Observe(uint32_t aBit) {
+    if (!channel || !aBit || (observed & aBit)) {
+      return false;
+    }
+    observed |= aBit;
+    return true;
+  }
+};
+
+inline ConnectionClaim NewConnectionClaim(uint64_t aChannel) {
+  if (!aChannel || aChannel != HttpStateChannel()) {
+    return {};
+  }
+  static Atomic<uint32_t> claims(0);
+  uint32_t prior = claims;
+  for (;;) {
+    if (prior >= 32) {
+      return {};
+    }
+    if (claims.compareExchange(prior, prior + 1)) {
+      return {aChannel, prior + 1, 0};
+    }
+    prior = claims;
+  }
+}
+// END MakOS connection claim diagnostics
 
 // Bounded load-path diagnostics, never page/TLS success proof. IDs come from
 // real load/channel objects; zero means unavailable. Flags: bit0 top-content,
@@ -334,4 +369,44 @@
 #  define MAKOS_TX_MANAGER(remote) ((void)0)
 #endif
 // END MakOS transaction macros
+
+// BEGIN MakOS connection claim macros
+#ifdef XP_MAKOS
+#  define MAKOS_CONN_CAPTURE(name, object) \
+    const auto name = (object)->mMakOSClaim
+#  define MAKOS_CONN_TRACE(claim, stage, result, actual, state) \
+    MAKOS_TX_TRACE((claim).channel, stage, result, actual, (claim).token, state)
+#  define MAKOS_CONN_CLAIM(object, aChannel, stage)                        \
+    do {                                                                 \
+      auto* makosObject = (object);                                       \
+      const auto makosClaim = mozilla::makos::NewConnectionClaim(aChannel); \
+      if (makosClaim.channel) {                                           \
+        makosObject->mMakOSClaim = makosClaim;                              \
+        MAKOS_CONN_TRACE(makosClaim, stage, 0, false,                       \
+                         makosObject->MakOSClaimState());                 \
+      }                                                                  \
+    } while (0)
+#  define MAKOS_CONN_TRANSFER(object, claim)       \
+    do {                                          \
+      if ((claim).channel) {                      \
+        (object)->mMakOSClaim = (claim);           \
+      }                                           \
+    } while (0)
+#  define MAKOS_CONN_ONCE(object, bit, stage, result, actual)    \
+    do {                                                       \
+      auto* makosObject = (object);                             \
+      if (makosObject->mMakOSClaim.Observe(bit)) {               \
+        MAKOS_CONN_CAPTURE(makosClaim, makosObject);             \
+        MAKOS_CONN_TRACE(makosClaim, stage, result, actual,      \
+                         makosObject->MakOSClaimState());       \
+      }                                                        \
+    } while (0)
+#else
+#  define MAKOS_CONN_CAPTURE(name, object) ((void)0)
+#  define MAKOS_CONN_TRACE(claim, stage, result, actual, state) ((void)0)
+#  define MAKOS_CONN_CLAIM(object, channel, stage) ((void)0)
+#  define MAKOS_CONN_TRANSFER(object, claim) ((void)0)
+#  define MAKOS_CONN_ONCE(object, bit, stage, result, actual) ((void)0)
+#endif
+// END MakOS connection claim macros
 #endif  // mozilla_MakOSRuntimeEvidence_h
