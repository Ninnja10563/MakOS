diff --git a/widget/makos/MakOSWindow.cpp b/widget/makos/MakOSWindow.cpp
--- a/widget/makos/MakOSWindow.cpp
+++ b/widget/makos/MakOSWindow.cpp
@@ -5,9 +5,13 @@
 
 #include "HeadlessWidget.h"
 #include "MakOSSurface.h"
+#include "MakOSWindow.h"
 #include "mozilla/gfx/2D.h"
 #include "nsIWidget.h"
 
 namespace mozilla::widget {
+
+class MakOSWindow;
+static MakOSWindow* gTopLevelWindow;
 
 class MakOSWindow final : public HeadlessWidget {
@@ -28,6 +32,7 @@ class MakOSWindow final : public HeadlessWidget {
       HeadlessWidget::Destroy();
       return NS_ERROR_FAILURE;
     }
+    gTopLevelWindow = this;
     makos::FillSurface(mSurface, 0xfff0f0f0, 0, 0, aRect.Width(),
                        aRect.Height());
     return NS_OK;
@@ -35,6 +40,9 @@ class MakOSWindow final : public HeadlessWidget {
   }
 
   void Destroy() override {
+    if (gTopLevelWindow == this) {
+      gTopLevelWindow = nullptr;
+    }
     if (mSurface != makos::kInvalidSurface) {
       makos::HideSurface(mSurface);
       mSurface = makos::kInvalidSurface;
@@ -83,11 +91,60 @@ class MakOSWindow final : public HeadlessWidget {
     mDrawTarget->ReleaseBits(pixels);
     (void)makos::PresentSurface(mSurface);
   }
 
+  bool ProcessNextSurfaceEvent() {
+    if (mSurface == makos::kInvalidSurface) {
+      return false;
+    }
+    makos::SurfaceEvent event{};
+    if (!makos::ReadSurfaceEvent(mSurface, event)) {
+      return false;
+    }
+    switch (static_cast<makos::SurfaceEventKind>(event.kind)) {
+      case makos::SurfaceEventKind::Pointer: {
+        LayoutDeviceIntPoint offset = WidgetToScreenOffset();
+        LayoutDeviceIntPoint point(offset.x + event.x, offset.y + event.y);
+        (void)SynthesizeNativeMouseEvent(
+            point, NativeMouseMessage::Move, MouseButton::eNotPressed,
+            nsIWidget::Modifiers::NO_MODIFIERS, nullptr);
+        bool wasDown = (mPointerButtons & 1) != 0;
+        bool isDown = (event.key & 1) != 0;
+        if (wasDown != isDown) {
+          (void)SynthesizeNativeMouseEvent(
+              point,
+              isDown ? NativeMouseMessage::ButtonDown
+                     : NativeMouseMessage::ButtonUp,
+              MouseButton::ePrimary, nsIWidget::Modifiers::NO_MODIFIERS,
+              nullptr);
+        }
+        mPointerButtons = event.key;
+        break;
+      }
+      case makos::SurfaceEventKind::Resize:
+        HeadlessWidget::Resize(event.width, event.height, true);
+        mDrawTarget = nullptr;
+        break;
+      case makos::SurfaceEventKind::Close:
+        if (mWidgetListener) {
+          (void)mWidgetListener->RequestWindowClose(this);
+        }
+        break;
+      case makos::SurfaceEventKind::Key:
+      case makos::SurfaceEventKind::None:
+        break;
+    }
+    return true;
+  }
+
  private:
   ~MakOSWindow() override { Destroy(); }
   makos::SurfaceHandle mSurface = makos::kInvalidSurface;
   RefPtr<gfx::DrawTarget> mDrawTarget;
+  uint32_t mPointerButtons = 0;
 };
 
+bool ProcessNextMakOSWindowEvent() {
+  return gTopLevelWindow && gTopLevelWindow->ProcessNextSurfaceEvent();
+}
+
 }  // namespace mozilla::widget
