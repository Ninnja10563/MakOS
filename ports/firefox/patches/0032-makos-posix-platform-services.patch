+nsresult nsMIMEInfoUnix::LoadUriInternal(nsIURI*) {
+  return NS_ERROR_NOT_IMPLEMENTED;
+}
+
+NS_IMETHODIMP nsMIMEInfoUnix::GetDefaultExecutable(nsIFile**) {
+  return NS_ERROR_NOT_IMPLEMENTED;
+}
+
+NS_IMETHODIMP nsMIMEInfoUnix::GetHasDefaultHandler(bool* aResult) {
+  if (GetDefaultApplication()) {
+    return nsMIMEInfoImpl::GetHasDefaultHandler(aResult);
