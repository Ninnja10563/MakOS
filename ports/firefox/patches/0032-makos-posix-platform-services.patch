From: MakOS Project <makos@localhost>
Subject: [PATCH] platform: add MakOS POSIX services and AArch64 XPTCall

Use poll/select libevent, AArch64 ELF XPTCall, ICU locale defaults, and an
honest external-handler backend without Linux desktop service dependencies.

diff --git a/intl/locale/moz.build b/intl/locale/moz.build
--- a/intl/locale/moz.build
+++ b/intl/locale/moz.build
@@ -20,6 +20,8 @@ elif toolkit == "gtk":
     DIRS += ["gtk"]
 elif toolkit == "android":
     DIRS += ["android"]
+elif toolkit == "makos":
+    DIRS += ["makos"]
 
 XPIDL_SOURCES += [
     "mozILocaleService.idl",
diff --git a/intl/locale/makos/moz.build b/intl/locale/makos/moz.build
new file mode 100644
--- /dev/null
+++ b/intl/locale/makos/moz.build
@@ -0,0 +1,10 @@
