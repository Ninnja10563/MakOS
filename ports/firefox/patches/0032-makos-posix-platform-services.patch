diff --git a/intl/locale/makos/OSPreferences_makos.cpp b/intl/locale/makos/OSPreferences_makos.cpp
new file mode 100644
--- /dev/null
+++ b/intl/locale/makos/OSPreferences_makos.cpp
@@ -0,0 +1,45 @@
+/* -*- Mode: C++; tab-width: 2; indent-tabs-mode: nil; c-basic-offset: 2 -*- */
+/* This Source Code Form is subject to the terms of the Mozilla Public
+ * License, v. 2.0. If a copy of the MPL was not distributed with this
+ * file, You can obtain one at http://mozilla.org/MPL/2.0/. */
+
+#include "OSPreferences.h"
+
+#include <locale.h>
+
+#include "mozilla/intl/Locale.h"
+
+using namespace mozilla::intl;
+
+OSPreferences::OSPreferences() = default;
+
+bool OSPreferences::ReadSystemLocales(nsTArray<nsCString>& aLocaleList) {
+  nsAutoCString locale(Locale::GetDefaultLocale());
+  if (!CanonicalizeLanguageTag(locale)) {
+    return false;
+  }
+  aLocaleList.AppendElement(locale);
+  return true;
+}
+
+bool OSPreferences::ReadRegionalPrefsLocales(
+    nsTArray<nsCString>& aLocaleList) {
+  nsAutoCString locale(setlocale(LC_TIME, nullptr));
+  if (!CanonicalizeLanguageTag(locale)) {
+    return ReadSystemLocales(aLocaleList);
+  }
+  aLocaleList.AppendElement(locale);
+  return true;
+}
+
+bool OSPreferences::ReadDateTimePattern(DateTimeFormatStyle aDateStyle,
+                                        DateTimeFormatStyle aTimeStyle,
+                                        const nsACString& aLocale,
+                                        nsACString& aRetVal) {
+  nsAutoCString skeleton;
+  return GetDateTimeSkeletonForStyle(aDateStyle, aTimeStyle, aLocale,
+                                     skeleton) &&
+         GetPatternForSkeleton(skeleton, aLocale, aRetVal);
+}
+
+void OSPreferences::RemoveObservers() {}
diff --git a/ipc/chromium/src/third_party/libeventcommon.mozbuild b/ipc/chromium/src/third_party/libeventcommon.mozbuild
--- a/ipc/chromium/src/third_party/libeventcommon.mozbuild
+++ b/ipc/chromium/src/third_party/libeventcommon.mozbuild
@@ -6,6 +6,8 @@
 
 if CONFIG['TARGET_KERNEL'] == 'Darwin':
     libevent_include_suffix = 'mac'
+elif CONFIG['TARGET_KERNEL'] == 'MakOS':
+    libevent_include_suffix = 'makos'
 elif CONFIG['TARGET_KERNEL'] in ('DragonFly', 'FreeBSD', 'NetBSD', 'OpenBSD'):
     libevent_include_suffix = 'bsd'
 elif CONFIG['TARGET_KERNEL'] == 'SunOS':
diff --git a/ipc/chromium/src/third_party/libevent/makos/event2/event-config.h b/ipc/chromium/src/third_party/libevent/makos/event2/event-config.h
new file mode 100644
--- /dev/null
+++ b/ipc/chromium/src/third_party/libevent/makos/event2/event-config.h
@@ -0,0 +1,15 @@
+/* MakOS libevent configuration: POSIX/musl baseline, poll/select backend. */
+#ifndef EVENT2_EVENT_CONFIG_MAKOS_H_INCLUDED_
+#define EVENT2_EVENT_CONFIG_MAKOS_H_INCLUDED_
+
+#include "../../linux/event2/event-config.h"
+
+/* Kernel does not expose Linux epoll/eventfd syscalls. */
+#undef EVENT__HAVE_EPOLL
+#undef EVENT__HAVE_EPOLL_CREATE1
+#undef EVENT__HAVE_EPOLL_CTL
+#undef EVENT__HAVE_EVENTFD
+#undef EVENT__HAVE_SYS_EPOLL_H
+#undef EVENT__HAVE_SYS_EVENTFD_H
+
+#endif
