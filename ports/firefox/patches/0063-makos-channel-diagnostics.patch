+#ifdef XP_MAKOS
+template <size_t Size>
+static void MakOSDocLoadTrace(const char (&aStage)[Size], nsresult aResult,
+                             nsDocShellLoadState* aState, nsIChannel* aChannel,
+                             bool aTopContent) {
+  // Declared first: restore after metadata COM pointers are released too.
+  struct RestoreErrno final {
+    int saved;
+    ~RestoreErrno() { errno = saved; }
+  } restore{errno};
+  uint64_t channelId = 0;
+  nsCOMPtr<nsIIdentChannel> identified = do_QueryInterface(aChannel);
+  if (identified) {
+    channelId = identified->ChannelId();
+  }
+  nsCOMPtr<nsIURI> uri;
+  if (aState) {
+    uri = aState->URI();
+  } else if (aChannel) {
+    aChannel->GetURI(getter_AddRefs(uri));
+  }
+  uint32_t flags = 8 | (aTopContent ? 1 : 0);
+  if (uri) {
+    flags |= uri->SchemeIs("http") ? 2 : 0;
+    flags |= uri->SchemeIs("https") ? 4 : 0;
+  }
+  mozilla::makos::WriteLoadDiagnostic(
+      aStage, Size - 1, static_cast<uint32_t>(aResult),
+      aState ? aState->GetLoadIdentifier() : 0, channelId, flags);
+}
+#  define MAKOS_DOC_LOAD(stage, result, state, channel) \
+    MakOSDocLoadTrace(stage, result, state, channel, \
+                      mBrowsingContext->IsTopContent())
+#else
+#  define MAKOS_DOC_LOAD(stage, result, state, channel) ((void)0)
+#endif
+
