From: MakOS Project <makos@localhost>
Subject: [PATCH] navigation: trace accepted loads through channel dispatch

Diagnostic only. Preserve synchronous returns, asynchronous callbacks,
normalization and every qualification limit. IDs/flags only, no URI text.
128 attempted single writes per process; no retry or missing-record inference.
Entry/call NS_OK is neutral metadata, not a completion.

diff --git a/mfbt/MakOSRuntimeEvidence.h b/mfbt/MakOSRuntimeEvidence.h
--- a/mfbt/MakOSRuntimeEvidence.h
+++ b/mfbt/MakOSRuntimeEvidence.h
@@ -68,7 +68,57 @@
   errno = savedErrno;
   return written == static_cast<ssize_t>(length);
 }
 
+
+// Bounded load-path diagnostics, never page/TLS success proof. IDs come from
+// real load/channel objects; zero means unavailable. Flags: bit0 top-content,
+// bit1 HTTP, bit2 HTTPS, bit3 top-content known. No URI/user-input text.
+// This separate cap does not change earlier evidence/diagnostic admission.
+inline bool WriteLoadDiagnostic(const char* aStage, size_t aStageLength,
+                                uint32_t aResult, uint64_t aLoad,
+                                uint64_t aChannel, uint32_t aFlags) {
+  static Atomic<uint32_t> attempts(0);
+  uint32_t prior = attempts;
+  for (;;) {
+    if (prior >= 128 || aStageLength > 32) {
+      return false;
+    }
+    if (attempts.compareExchange(prior, prior + 1)) {
+      break;
+    }
+    prior = attempts;
+  }
+  char record[256];
+  size_t length = 0;
+  auto append = [&](const char* text) {
+    while (*text) {
+      record[length++] = *text++;
+    }
+  };
+  auto hex = [&](uint64_t value, int highShift) {
+    for (int shift = highShift; shift >= 0; shift -= 4) {
+      record[length++] = "0123456789abcdef"[(value >> shift) & 15];
+    }
+  };
+  append("MAKOS_FIREFOX_LOAD_DIAGNOSTIC stage=");
+  for (size_t index = 0; index < aStageLength; ++index) {
+    record[length++] = aStage[index];
+  }
+  append(" result=0x");
+  hex(aResult, 28);
+  append(" load=0x");
+  hex(aLoad, 60);
+  append(" channel=0x");
+  hex(aChannel, 60);
+  append(" flags=0x");
+  hex(aFlags, 28);
+  append(" scope=diagnostic-only\n");
+  const int savedErrno = errno;
+  const ssize_t written = write(STDERR_FILENO, record, length);
+  errno = savedErrno;
+  return written == static_cast<ssize_t>(length);
+}
+
 }  // namespace mozilla::makos
 #endif  // XP_MAKOS
 #endif  // mozilla_MakOSRuntimeEvidence_h
