+          mainRunnableReady) {
+        bool accepted = makos::NotifySurfaceMainHandoffReady();
+        if (!mMainHandoffTraceReported.exchange(true)) {
+          printf_stderr(
+              "MAKOS_WIDGET_MAIN_HANDOFF_%s source=post-enqueue "
+              "syscall=149 sequence=%llu\n",
+              accepted ? "OK" : "FAIL",
+              static_cast<unsigned long long>(sequence));
+        }
       }
     }
   }
@@ -589,6 +605,7 @@ class MakOSWindow final : public HeadlessWidget {
   mozilla::Atomic<uint32_t> mEnqueueTraceCount{0};
   uint32_t mDispatchTraceCount = 0;
   uint32_t mPointerButtons = 0;
+  mozilla::Atomic<bool> mMainHandoffTraceReported{false};
   mozilla::Atomic<bool> mEventWatcherRunning{false};
   mozilla::Atomic<bool> mMainDrainScheduled{false};
