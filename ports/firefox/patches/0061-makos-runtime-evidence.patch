+// This reports a successful, nonempty frame display-list IPC submission.
+// It does not claim rasterization, scanout, or usable browser pixels; the
+// independent guest blit and framebuffer/interaction tests remain mandatory.
+static void ReportMakOSPaintSubmission(
+    nsDisplayList* aDisplayList, nsDisplayListBuilder* aDisplayListBuilder,
+    bool aSubmitted, bool aOffscreen, const LayoutDeviceIntSize& aSize) {
+  if (!aSubmitted || !aDisplayList || aDisplayList->IsEmpty() ||
+      !aDisplayListBuilder || !aDisplayListBuilder->IsPaintingToWindow() ||
+      aOffscreen || aSize.IsEmpty()) {
+    return;
+  }
+  nsIFrame* root = aDisplayListBuilder->RootReferenceFrame();
+  if (!root) {
+    return;
+  }
+  PresShell* shell = root->PresContext()->PresShell();
+  if (!shell || !shell->IsActive() || shell->IsPaintingSuppressed()) {
+    return;
+  }
+  dom::Document* document = shell->GetDocument();
+  nsIURI* uri = document ? document->GetDocumentURI() : nullptr;
+  nsAutoCString spec;
+  if (!uri || NS_FAILED(uri->GetSpec(spec))) {
+    return;
+  }
+
+  // Use this frame's document, never the primary content URL used by the
+  // profiler. Exact fixed strings also prevent untrusted URL log injection.
+  if (spec.EqualsLiteral("chrome://browser/content/browser.xhtml")) {
+    static Atomic<bool> attempted(false);
+    static constexpr char record[] =
+        "MAKOS_PRES_PAINT uri=chrome://browser/content/browser.xhtml\n";
+    (void)makos::WriteRuntimeEvidenceOnce(attempted, record);
+  } else if (spec.EqualsLiteral("chrome://global/content/commonDialog.xhtml")) {
+    static Atomic<bool> attempted(false);
+    static constexpr char record[] =
+        "MAKOS_PRES_PAINT uri=chrome://global/content/commonDialog.xhtml\n";
+    (void)makos::WriteRuntimeEvidenceOnce(attempted, record);
+  }
+}
+#endif  // XP_MAKOS

 WebRenderLayerManager::WebRenderLayerManager(nsIWidget* aWidget)
     : mWidget(aWidget),
