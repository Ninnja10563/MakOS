diff --git a/js/src/jit/ExecutableAllocator.cpp b/js/src/jit/ExecutableAllocator.cpp
--- a/js/src/jit/ExecutableAllocator.cpp
+++ b/js/src/jit/ExecutableAllocator.cpp
@@ -27,5 +27,8 @@

 #include "jit/ExecutableAllocator.h"
+#ifdef XP_MAKOS
+#  include "mozilla/MakOSRuntimeEvidence.h"
+#endif

 #include "js/MemoryMetrics.h"
 #include "util/Poison.h"
@@ -170,25 +173,31 @@
 ExecutablePool* ExecutableAllocator::createPool(size_t n) {
   size_t allocSize = roundUpAllocationSize(n, ExecutableCodePageSize);
   if (allocSize == OVERSIZE_ALLOCATION) {
     return nullptr;
   }

   ExecutablePool::Allocation a = systemAlloc(allocSize);
   if (!a.pages) {
     return nullptr;
   }

   ExecutablePool* pool = js_new<ExecutablePool>(this, a);
   if (!pool) {
     systemRelease(a);
     return nullptr;
   }

   if (!m_pools.put(pool)) {
     // Note: this will call |systemRelease(a)|.
     js_delete(pool);
     return nullptr;
   }
+#ifdef XP_MAKOS
+  // A registered executable allocation, not a claim of generated-code execution.
+  static mozilla::Atomic<bool> attempted(false);
+  static constexpr char record[] = "MAKOS_JIT_POOL_OK\n";
+  (void)mozilla::makos::WriteRuntimeEvidenceOnce(attempted, record);
+#endif

   return pool;
 }
