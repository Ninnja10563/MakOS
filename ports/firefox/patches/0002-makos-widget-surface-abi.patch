diff --git a/widget/makos/MakOSSurface.cpp b/widget/makos/MakOSSurface.cpp
new file mode 100644
index 0000000000..eadcfb7821
--- /dev/null
+++ b/widget/makos/MakOSSurface.cpp
@@ -0,0 +1,69 @@
+/* -*- Mode: C++; tab-width: 2; indent-tabs-mode: nil; c-basic-offset: 2 -*- */
+/* This Source Code Form is subject to the terms of the Mozilla Public
+ * License, v. 2.0. If a copy of the MPL was not distributed with this
+ * file, You can obtain one at http://mozilla.org/MPL/2.0/. */
+
+#include "MakOSSurface.h"
+
+namespace mozilla::widget::makos {
+
+namespace {
+
+enum class Syscall : uint64_t {
+  Yield = 1,
+  SurfaceCreate = 8,
+  SurfaceFill = 9,
+  SurfacePresent = 10,
+  SurfaceClose = 58,
+  SurfaceReadEvent = 60,
+};
+
+uint64_t Svc4(Syscall aNumber, uint64_t aFirst, uint64_t aSecond,
+              uint64_t aThird, uint64_t aFourth) {
+#if defined(__aarch64__) && defined(MOZ_WIDGET_MAKOS)
+  register uint64_t x0 __asm__("x0") = aFirst;
+  register uint64_t x1 __asm__("x1") = aSecond;
+  register uint64_t x2 __asm__("x2") = aThird;
+  register uint64_t x3 __asm__("x3") = aFourth;
+  register uint64_t x8 __asm__("x8") = static_cast<uint64_t>(aNumber);
+  __asm__ volatile("svc #0"
+                   : "+r"(x0)
+                   : "r"(x1), "r"(x2), "r"(x3), "r"(x8)
+                   : "memory", "cc");
+  return x0;
+#else
+#  error "MakOS widget backend requires AArch64 and MOZ_WIDGET_MAKOS"
+#endif
+}
+
+}  // namespace
+
+SurfaceHandle CreateSurface(uint32_t aWidth, uint32_t aHeight,
+                            uint64_t aReservedSlot) {
+  return Svc4(Syscall::SurfaceCreate, aWidth, aHeight, aReservedSlot, 0);
+}
+
+bool FillSurface(SurfaceHandle aSurface, uint32_t aArgb, uint32_t aX,
+                 uint32_t aY, uint32_t aWidth, uint32_t aHeight) {
+  const uint32_t rectangle[4] = {aX, aY, aWidth, aHeight};
+  return Svc4(Syscall::SurfaceFill, aSurface, aArgb,
+              reinterpret_cast<uint64_t>(rectangle), 0) == 1;
+}
+
+bool PresentSurface(SurfaceHandle aSurface) {
+  return Svc4(Syscall::SurfacePresent, aSurface, 0, 0, 0) == 1;
+}
+
+bool HideSurface(SurfaceHandle aSurface) {
+  return Svc4(Syscall::SurfaceClose, aSurface, 0, 0, 0) == 1;
+}
+
+bool ReadSurfaceEvent(SurfaceHandle aSurface, SurfaceEvent& aEvent) {
+  return Svc4(Syscall::SurfaceReadEvent, aSurface,
+              reinterpret_cast<uint64_t>(&aEvent), sizeof(aEvent), 0) ==
+         sizeof(aEvent);
+}
+
+void YieldThread() { (void)Svc4(Syscall::Yield, 0, 0, 0, 0); }
+
+}  // namespace mozilla::widget::makos
diff --git a/widget/makos/MakOSSurface.h b/widget/makos/MakOSSurface.h
new file mode 100644
index 0000000000..aefc1d2dc2
--- /dev/null
+++ b/widget/makos/MakOSSurface.h
@@ -0,0 +1,54 @@
+/* -*- Mode: C++; tab-width: 2; indent-tabs-mode: nil; c-basic-offset: 2 -*- */
+/* This Source Code Form is subject to the terms of the Mozilla Public
+ * License, v. 2.0. If a copy of the MPL was not distributed with this
+ * file, You can obtain one at http://mozilla.org/MPL/2.0/. */
+
+#ifndef mozilla_widget_MakOSSurface_h
+#define mozilla_widget_MakOSSurface_h
+
+#include <stdint.h>
+
+namespace mozilla::widget::makos {
+
+using SurfaceHandle = uint64_t;
+
+constexpr uint64_t kInvalidSurface = 0;
+// Current compositor reserves selector 5 for the browser, mapping to its
+// fixed browser surface. General surface allocation remains a kernel gate.
+constexpr uint64_t kBrowserSurfaceSlot = 5;
+
+enum class SurfaceEventKind : uint32_t {
+  None = 0,
+  Key = 1,
+  Pointer = 2,
+  Resize = 3,
+  Close = 4,
+};
+
+struct SurfaceEvent {
+  uint32_t kind;
+  uint32_t key;
+  uint32_t modifiers;
+  int32_t x;
+  int32_t y;
+  uint32_t width;
+  uint32_t height;
+};
+
+static_assert(sizeof(SurfaceEvent) == 28,
+              "MakOS kernel surface-event ABI changed");
+
+SurfaceHandle CreateSurface(uint32_t aWidth, uint32_t aHeight,
+                            uint64_t aReservedSlot);
+bool FillSurface(SurfaceHandle aSurface, uint32_t aArgb, uint32_t aX,
+                 uint32_t aY, uint32_t aWidth, uint32_t aHeight);
+bool PresentSurface(SurfaceHandle aSurface);
+// Current close operation hides a retained surface; it does not destroy the
+// process or release the handle.
+bool HideSurface(SurfaceHandle aSurface);
+bool ReadSurfaceEvent(SurfaceHandle aSurface, SurfaceEvent& aEvent);
+void YieldThread();
+
+}  // namespace mozilla::widget::makos
+
+#endif  // mozilla_widget_MakOSSurface_h
