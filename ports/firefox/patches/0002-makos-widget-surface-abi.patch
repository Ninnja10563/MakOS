+
+#include "GfxInfoBase.h"
+
+namespace mozilla::widget {
+
+class GfxInfo final : public GfxInfoBase {
+ public:
+  NS_IMETHOD GetD2DEnabled(bool* aEnabled) override;
+  NS_IMETHOD GetDWriteEnabled(bool* aEnabled) override;
+  NS_IMETHOD GetDWriteVersion(nsAString& aVersion) override;
+  NS_IMETHOD GetEmbeddedInFirefoxReality(bool* aEmbedded) override;
+  NS_IMETHOD GetHasBattery(bool* aHasBattery) override;
+  NS_IMETHOD GetCleartypeParameters(nsAString& aParameters) override;
+  NS_IMETHOD GetWindowProtocol(nsAString& aProtocol) override;
+  NS_IMETHOD GetTestType(nsAString& aTestType) override;
+  NS_IMETHOD GetAdapterDescription(nsAString& aDescription) override;
+  NS_IMETHOD GetAdapterDriver(nsAString& aDriver) override;
+  NS_IMETHOD GetAdapterVendorID(nsAString& aVendor) override;
+  NS_IMETHOD GetAdapterDeviceID(nsAString& aDevice) override;
+  NS_IMETHOD GetAdapterSubsysID(nsAString& aSubsystem) override;
+  NS_IMETHOD GetAdapterRAM(uint32_t* aRam) override;
+  NS_IMETHOD GetAdapterDriverVendor(nsAString& aVendor) override;
+  NS_IMETHOD GetAdapterDriverVersion(nsAString& aVersion) override;
+  NS_IMETHOD GetAdapterDriverDate(nsAString& aDate) override;
+  NS_IMETHOD GetAdapterDescription2(nsAString& aDescription) override;
+  NS_IMETHOD GetAdapterDriver2(nsAString& aDriver) override;
+  NS_IMETHOD GetAdapterVendorID2(nsAString& aVendor) override;
+  NS_IMETHOD GetAdapterDeviceID2(nsAString& aDevice) override;
+  NS_IMETHOD GetAdapterSubsysID2(nsAString& aSubsystem) override;
+  NS_IMETHOD GetAdapterRAM2(uint32_t* aRam) override;
+  NS_IMETHOD GetAdapterDriverVendor2(nsAString& aVendor) override;
+  NS_IMETHOD GetAdapterDriverVersion2(nsAString& aVersion) override;
+  NS_IMETHOD GetAdapterDriverDate2(nsAString& aDate) override;
+  NS_IMETHOD GetIsGPU2Active(bool* aActive) override;
+  NS_IMETHOD GetDrmRenderDevice(nsACString& aDevice) override;
+  using GfxInfoBase::GetFeatureStatus;
+  using GfxInfoBase::GetFeatureSuggestedDriverVersion;
+
+#ifdef DEBUG
+  NS_DECL_ISUPPORTS_INHERITED
+  NS_DECL_NSIGFXINFODEBUG
+#endif
+
+ protected:
+  ~GfxInfo() = default;
+  OperatingSystem GetOperatingSystem() override {
+    return OperatingSystem::MakOS;
+  }
+  nsresult GetFeatureStatusImpl(
+      int32_t aFeature, int32_t* aStatus, nsAString& aSuggestedDriverVersion,
+      const nsTArray<GfxDriverInfo>& aDriverInfo, nsACString& aFailureId,
+      OperatingSystem* aOS = nullptr) override;
+  const nsTArray<GfxDriverInfo>& GetGfxDriverInfo() override;
+};
