From: MakOS Project <makos@localhost>
Subject: [PATCH] net: observe first-channel transaction admission and DNS continuation

Diagnostic only: preserve transaction policy, cache, DNS retries and all gates.
Record actual API results, explicit pending/admission branches and process identity.
Independent bounded32+one saturation attempts; one manager-selection record.
No URI/hostname capture, profile changes, forced dispatch or network bypass.

---
diff --git a/mfbt/MakOSRuntimeEvidence.h b/mfbt/MakOSRuntimeEvidence.h
--- a/mfbt/MakOSRuntimeEvidence.h
+++ b/mfbt/MakOSRuntimeEvidence.h
@@ -148,6 +148,105 @@
 }
 // END MakOS HTTP boundary diagnostics
 
+// BEGIN MakOS transaction diagnostics
+// Scalars captured before potentially reentrant calls. No lifetime extension.
+template <class Getter>
+inline uint64_t CaptureTransactionChannel(Getter aGetter) {
+  const int savedErrno = errno;
+  const uint64_t channel = aGetter();
+  errno = savedErrno;
+  return channel;
+}
+
+// Private transport for the admitted transaction/manager records below.
+// arg0/arg1 meanings are stage-specific; NS_OK at entry is explicitly neutral.
+inline bool WriteTransactionRecord(const char* aStage, size_t aStageLength,
+                                   uint32_t aResult, bool aActualResult,
+                                   uint64_t aChannel, uint32_t aArg0,
+                                   uint32_t aArg1, bool aSaturated) {
+  if (aStageLength > 32) {
+    return false;
+  }
+  const int savedErrno = errno;
+  const uint32_t pid = static_cast<uint32_t>(getpid());
+  char record[256];
+  size_t length = 0;
+  auto append = [&](const char* text) {
+    while (*text) {
+      record[length++] = *text++;
+    }
+  };
+  auto hex = [&](uint64_t value, int highShift) {
+    for (int shift = highShift; shift >= 0; shift -= 4) {
+      record[length++] = "0123456789abcdef"[(value >> shift) & 15];
+    }
+  };
+  if (aSaturated) {
+    append("MAKOS_FIREFOX_TRANSACTION_SATURATED pid=0x");
+    hex(pid, 28);
+    append(" channel=0x");
+    hex(aChannel, 60);
+    append(" cap=32 further_records=omitted scope=diagnostic-only\n");
+  } else {
+    append("MAKOS_FIREFOX_TRANSACTION stage=");
+    for (size_t index = 0; index < aStageLength; ++index) {
+      record[length++] = aStage[index];
+    }
+    append(" pid=0x");
+    hex(pid, 28);
+    append(" channel=0x");
+    hex(aChannel, 60);
+    append(" result=0x");
+    hex(aResult, 28);
+    append(aActualResult ? " result_kind=actual" : " result_kind=neutral");
+    append(" arg0=0x");
+    hex(aArg0, 28);
+    append(" arg1=0x");
+    hex(aArg1, 28);
+    append(" scope=diagnostic-only\n");
+  }
+  const ssize_t written = write(STDERR_FILENO, record, length);
+  errno = savedErrno;
+  return !aSaturated && written == static_cast<ssize_t>(length);
+}
+
+// First-channel latch is process-local. Separate 32+1 attempt budget; no retry
+// or attempt refund after short/error writes. Existing diagnostic caps unchanged.
+inline bool WriteTransactionDiagnostic(const char* aStage, size_t aStageLength,
+                                       uint32_t aResult, bool aActualResult,
+                                       uint64_t aChannel, uint32_t aArg0,
+                                       uint32_t aArg1) {
+  if (aStageLength > 32 || !aChannel || aChannel != HttpStateChannel()) {
+    return false;
+  }
+  static Atomic<uint32_t> attempts(0);
+  uint32_t prior = attempts;
+  for (;;) {
+    if (prior >= 33) {
+      return false;
+    }
+    if (attempts.compareExchange(prior, prior + 1)) {
+      break;
+    }
+    prior = attempts;
+  }
+  return WriteTransactionRecord(aStage, aStageLength, aResult, aActualResult,
+                                aChannel, aArg0, aArg1, prior == 32);
+}
+
+// One manager-selection attempt per process, independent of channel admission.
+// Channel zero explicitly means startup configuration, not a target request.
+inline bool WriteTransactionManager(bool aRemote) {
+  static Atomic<bool> attempted(false);
+  if (attempted.exchange(true)) {
+    return false;
+  }
+  return aRemote
+             ? WriteTransactionRecord("manager-ipc", 11, 0, false, 0, 0, 0, false)
+             : WriteTransactionRecord("manager-local", 13, 0, false, 0, 0, 0, false);
+}
+// END MakOS transaction diagnostics
+
 // Bounded load-path diagnostics, never page/TLS success proof. IDs come from
 // real load/channel objects; zero means unavailable. Flags: bit0 top-content,
 // bit1 HTTP, bit2 HTTPS, bit3 top-content known. No URI/user-input text.
@@ -213,4 +312,26 @@
 
 }  // namespace mozilla::makos
 #endif  // XP_MAKOS
+
+// BEGIN MakOS transaction macros
+#ifdef XP_MAKOS
+#  define MAKOS_TX_CAPTURE(name, expression)                                  \
+    const uint64_t name = mozilla::makos::CaptureTransactionChannel([&]() {    \
+      auto* makosTransaction = (expression);                                 \
+      return makosTransaction ? makosTransaction->ChannelId() : uint64_t(0); \
+    })
+#  define MAKOS_TX_VALUE(name, expression) \
+    const uint32_t name = static_cast<uint32_t>(expression)
+#  define MAKOS_TX_TRACE(channel, stage, result, actual, arg0, arg1)          \
+    mozilla::makos::WriteTransactionDiagnostic(                              \
+        stage, sizeof(stage) - 1, static_cast<uint32_t>(result), actual,      \
+        channel, static_cast<uint32_t>(arg0), static_cast<uint32_t>(arg1))
+#  define MAKOS_TX_MANAGER(remote) mozilla::makos::WriteTransactionManager(remote)
+#else
+#  define MAKOS_TX_CAPTURE(name, expression) ((void)0)
+#  define MAKOS_TX_VALUE(name, expression) ((void)0)
+#  define MAKOS_TX_TRACE(channel, stage, result, actual, arg0, arg1) ((void)0)
+#  define MAKOS_TX_MANAGER(remote) ((void)0)
+#endif
+// END MakOS transaction macros
 #endif  // mozilla_MakOSRuntimeEvidence_h
