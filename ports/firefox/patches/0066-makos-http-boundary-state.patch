From: MakOS Project <makos@localhost>
Subject: [PATCH] net: capture first top-web channel cache and transaction state

Diagnostic-only: preserve HTTP control flow, existing load-record admission,
returns and browser gates. Select the first real nonzero top-content web channel,
retain 32 independent state-record attempts and one truthful saturation notice.
No URLs, preferences, retries, cache bypass or network-policy changes.

---
diff --git a/mfbt/MakOSRuntimeEvidence.h b/mfbt/MakOSRuntimeEvidence.h
--- a/mfbt/MakOSRuntimeEvidence.h
+++ b/mfbt/MakOSRuntimeEvidence.h
@@ -70,6 +70,84 @@
 }
 
 
+// BEGIN MakOS HTTP boundary diagnostics
+// First known top-content HTTP(S) channel only. No reset or redirect inference.
+inline Atomic<uint64_t>& HttpStateChannel() {
+  static Atomic<uint64_t> channel(0);
+  return channel;
+}
+
+inline void ObserveHttpStateChannel(uint64_t aChannel, uint32_t aFlags) {
+  if (aChannel && (aFlags & 9u) == 9u && (aFlags & 6u) != 0) {
+    HttpStateChannel().compareExchange(0, aChannel);
+  }
+}
+
+// Independent diagnostic budget; the original load-record cap is unchanged.
+// Attempts include short/error writes. The extra slot reports saturation once,
+// not a final count of omitted records. No retries or fragmented reconstruction.
+// True means the requested stage was fully written; saturation returns false.
+inline bool WriteHttpStateDiagnostic(const char* aStage, size_t aStageLength,
+                                    uint32_t aResult, bool aActualResult,
+                                    bool aAfterState, uint64_t aChannel,
+                                    uint32_t aWait, uint32_t aState,
+                                    uint32_t aSuspend) {
+  if (aStageLength > 32 || !aChannel || aChannel != HttpStateChannel()) {
+    return false;
+  }
+  static Atomic<uint32_t> attempts(0);
+  uint32_t prior = attempts;
+  for (;;) {
+    if (prior >= 33) {
+      return false;
+    }
+    if (attempts.compareExchange(prior, prior + 1)) {
+      break;
+    }
+    prior = attempts;
+  }
+  char record[256];
+  size_t length = 0;
+  auto append = [&](const char* text) {
+    while (*text) {
+      record[length++] = *text++;
+    }
+  };
+  auto hex = [&](uint64_t value, int highShift) {
+    for (int shift = highShift; shift >= 0; shift -= 4) {
+      record[length++] = "0123456789abcdef"[(value >> shift) & 15];
+    }
+  };
+  if (prior == 32) {
+    append("MAKOS_FIREFOX_HTTP_STATE_SATURATED channel=0x");
+    hex(aChannel, 60);
+    append(" cap=32 further_records=omitted scope=diagnostic-only\n");
+  } else {
+    append("MAKOS_FIREFOX_HTTP_STATE stage=");
+    for (size_t index = 0; index < aStageLength; ++index) {
+      record[length++] = aStage[index];
+    }
+    append(" result=0x");
+    hex(aResult, 28);
+    append(aActualResult ? " result_kind=actual" : " result_kind=neutral");
+    append(aAfterState ? " state_phase=after" : " state_phase=entry");
+    append(" channel=0x");
+    hex(aChannel, 60);
+    append(" wait=0x");
+    hex(aWait, 28);
+    append(" state=0x");
+    hex(aState, 28);
+    append(" suspend=0x");
+    hex(aSuspend, 28);
+    append(" scope=diagnostic-only\n");
+  }
+  const int savedErrno = errno;
+  const ssize_t written = write(STDERR_FILENO, record, length);
+  errno = savedErrno;
+  return prior < 32 && written == static_cast<ssize_t>(length);
+}
+// END MakOS HTTP boundary diagnostics
+
 // Bounded load-path diagnostics, never page/TLS success proof. IDs come from
 // real load/channel objects; zero means unavailable. Flags: bit0 top-content,
 // bit1 HTTP, bit2 HTTPS, bit3 top-content known. No URI/user-input text.
@@ -80,6 +158,7 @@
   if (aStageLength > 32) {
     return false;
   }
+  ObserveHttpStateChannel(aChannel, aFlags);
   // Arm once for a known top-content HTTP/HTTPS load. Do not spend the
   // bounded diagnostic budget on earlier non-web startup loads. Once armed,
   // retain unknown-metadata callbacks too; never reset admission on a load.
diff --git a/netwerk/protocol/http/nsHttpChannel.cpp b/netwerk/protocol/http/nsHttpChannel.cpp
--- a/netwerk/protocol/http/nsHttpChannel.cpp
+++ b/netwerk/protocol/http/nsHttpChannel.cpp
@@ -18,6 +18,43 @@
 #  define MAKOS_HTTP_SNAPSHOT() ((void)0)
 #  define MAKOS_HTTP_CONT(stage, result, channel) ((void)0)
 #endif
+
+// BEGIN MakOS HTTP boundary diagnostics
+#ifdef XP_MAKOS
+struct MakosHttpBoundaryState {
+  uint64_t channel;
+  uint32_t wait;
+  uint32_t state;
+  uint32_t suspend;
+};
+// Main-thread scalar snapshots only. Bits: 0 network-triggered, 1 proxy request,
+// 2 waiting-proxy, 3 DNS promise pending, 4 cache entry, 5 canceled, 6 pending,
+// 7 transaction, 8 transaction pump, 9 cache pump, 10 async resume, 11 cache race.
+#  define MAKOS_HTTP_STATE_CAPTURE(name)                                      \
+    const MakosHttpBoundaryState name {                                      \
+      mChannelId, LoadWaitForCacheEntry(),                                    \
+          (uint32_t(bool(mNetworkTriggered)) << 0) |                         \
+              (uint32_t(bool(mProxyRequest)) << 1) |                         \
+              (uint32_t(bool(mWaitingForProxy)) << 2) |                      \
+              (uint32_t(!mDNSBlockingPromise.IsEmpty()) << 3) |              \
+              (uint32_t(bool(mCacheEntry)) << 4) |                           \
+              (uint32_t(bool(mCanceled)) << 5) |                             \
+              (uint32_t(LoadIsPending()) << 6) |                             \
+              (uint32_t(bool(mTransaction)) << 7) |                          \
+              (uint32_t(bool(mTransactionPump)) << 8) |                      \
+              (uint32_t(bool(mCachePump)) << 9) |                            \
+              (uint32_t(LoadAsyncResumePending()) << 10) |                   \
+              (uint32_t(bool(mRaceCacheWithNetwork)) << 11), mSuspendCount   \
+    }
+#  define MAKOS_HTTP_STATE_TRACE(snapshot, stage, result, actual, after)       \
+    mozilla::makos::WriteHttpStateDiagnostic(                                 \
+        stage, sizeof(stage) - 1, static_cast<uint32_t>(result), actual,       \
+        after, snapshot.channel, snapshot.wait, snapshot.state, snapshot.suspend)
+#else
+#  define MAKOS_HTTP_STATE_CAPTURE(name) ((void)0)
+#  define MAKOS_HTTP_STATE_TRACE(snapshot, stage, result, actual, after) ((void)0)
+#endif
+// END MakOS HTTP boundary diagnostics
 
 #include <inttypes.h>
 
@@ -1107,9 +1144,12 @@
