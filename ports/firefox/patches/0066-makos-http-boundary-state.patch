+  MAKOS_HTTP_STATE_TRACE(makosCacheAfter, "cache-open-return", rv, true, true);
 
   // do not continue if asyncOpenCacheEntry is in progress
   if (AwaitingCacheCallbacks()) {
@@ -1251,11 +1297,14 @@
 }
 
 nsresult nsHttpChannel::ContinueConnect() {
+  MAKOS_HTTP_STATE_CAPTURE(makosState);
