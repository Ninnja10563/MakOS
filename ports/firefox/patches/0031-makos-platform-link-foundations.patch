diff --git a/toolkit/components/processtools/ProcInfo_makos.cpp b/toolkit/components/processtools/ProcInfo_makos.cpp
new file mode 100644
--- /dev/null
+++ b/toolkit/components/processtools/ProcInfo_makos.cpp
@@ -0,0 +1,36 @@
+/* -*- Mode: C++; tab-width: 2; indent-tabs-mode: nil; c-basic-offset: 2 -*- */
+/* This Source Code Form is subject to the terms of the Mozilla Public
+ * License, v. 2.0. If a copy of the MPL was not distributed with this
+ * file, You can obtain one at http://mozilla.org/MPL/2.0/. */
+
+#include "mozilla/ProcInfo.h"
+
+#include <time.h>
+
+namespace mozilla {
+
+int GetCycleTimeFrequencyMHz() { return 0; }
+
+nsresult GetCpuTimeSinceProcessStartInMs(uint64_t* aResult) {
+  timespec time{};
+  if (clock_gettime(CLOCK_PROCESS_CPUTIME_ID, &time) != 0) {
+    return NS_ERROR_NOT_AVAILABLE;
+  }
+  *aResult = uint64_t(time.tv_sec) * 1000u + uint64_t(time.tv_nsec) / 1000000u;
+  return NS_OK;
+}
+
+nsresult GetGpuTimeSinceProcessStartInMs(uint64_t*) {
+  return NS_ERROR_NOT_IMPLEMENTED;
+}
+
+ProcInfoPromise::ResolveOrRejectValue GetProcInfoSync(
+    nsTArray<ProcInfoRequest>&&) {
+  ProcInfoPromise::ResolveOrRejectValue result;
+  // MakOS needs a process-stat syscall before Gecko can truthfully enumerate
+  // another process's threads, memory, and CPU time.
+  result.SetReject(NS_ERROR_NOT_IMPLEMENTED);
+  return result;
+}
+
+}  // namespace mozilla
