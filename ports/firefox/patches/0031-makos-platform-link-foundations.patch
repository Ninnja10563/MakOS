diff --git a/widget/makos/MakOSWindow.cpp b/widget/makos/MakOSWindow.cpp
new file mode 100644
--- /dev/null
+++ b/widget/makos/MakOSWindow.cpp
@@ -0,0 +1,67 @@
+/* -*- Mode: C++; tab-width: 2; indent-tabs-mode: nil; c-basic-offset: 2 -*- */
+/* This Source Code Form is subject to the terms of the Mozilla Public
+ * License, v. 2.0. If a copy of the MPL was not distributed with this
+ * file, You can obtain one at http://mozilla.org/MPL/2.0/. */
+
+#include "HeadlessWidget.h"
+#include "MakOSSurface.h"
+#include "nsIWidget.h"
+
+namespace mozilla::widget {
+
+class MakOSWindow final : public HeadlessWidget {
+ public:
+  NS_INLINE_DECL_REFCOUNTING_INHERITED(MakOSWindow, HeadlessWidget)
+
+  nsresult Create(nsIWidget* aParent, const LayoutDeviceIntRect& aRect,
+                  InitData* aInitData = nullptr) override {
+    nsresult result = HeadlessWidget::Create(aParent, aRect, aInitData);
+    if (NS_FAILED(result)) {
+      return result;
+    }
+    mSurface = makos::CreateSurface(aRect.Width(), aRect.Height(),
+                                    makos::kBrowserSurfaceSlot);
+    if (mSurface == makos::kInvalidSurface) {
+      HeadlessWidget::Destroy();
+      return NS_ERROR_FAILURE;
+    }
+    makos::FillSurface(mSurface, 0xfff0f0f0, 0, 0, aRect.Width(),
+                       aRect.Height());
+    return NS_OK;
+  }
+
+  void Destroy() override {
+    if (mSurface != makos::kInvalidSurface) {
+      makos::HideSurface(mSurface);
+      mSurface = makos::kInvalidSurface;
+    }
+    HeadlessWidget::Destroy();
+  }
+
+  void Show(bool aState) override {
+    if (mSurface != makos::kInvalidSurface) {
+      if (aState) {
+        makos::PresentSurface(mSurface);
+      } else {
+        makos::HideSurface(mSurface);
+      }
+    }
+    HeadlessWidget::Show(aState);
+  }
+
+ private:
+  ~MakOSWindow() override { Destroy(); }
+  makos::SurfaceHandle mSurface = makos::kInvalidSurface;
+};
+
+}  // namespace mozilla::widget
+
+already_AddRefed<nsIWidget> nsIWidget::CreateTopLevelWindow() {
+  nsCOMPtr<nsIWidget> widget = new mozilla::widget::MakOSWindow();
+  return widget.forget();
+}
+
+already_AddRefed<nsIWidget> nsIWidget::CreateChildWindow() {
+  nsCOMPtr<nsIWidget> widget = new mozilla::widget::MakOSWindow();
+  return widget.forget();
+}
