set(CMAKE_SYSTEM_NAME MakOS)
set(CMAKE_SYSTEM_PROCESSOR aarch64)
set(CMAKE_TRY_COMPILE_TARGET_TYPE STATIC_LIBRARY)

set(CMAKE_C_COMPILER "$ENV{MAKOS_CC}")
set(CMAKE_CXX_COMPILER "$ENV{MAKOS_CXX}")
set(CMAKE_ASM_COMPILER "$ENV{MAKOS_CC}")
set(CMAKE_C_COMPILER_TARGET aarch64-unknown-makos)
set(CMAKE_CXX_COMPILER_TARGET aarch64-unknown-makos)
set(CMAKE_ASM_COMPILER_TARGET aarch64-unknown-makos)
set(CMAKE_AR "$ENV{MAKOS_AR}")
set(CMAKE_RANLIB "$ENV{MAKOS_RANLIB}")
set(CMAKE_SYSROOT "$ENV{MAKOS_SYSROOT}")
set(CMAKE_FIND_ROOT_PATH "$ENV{MAKOS_SYSROOT}")
set(CMAKE_FIND_ROOT_PATH_MODE_PROGRAM NEVER)
set(CMAKE_FIND_ROOT_PATH_MODE_LIBRARY ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_INCLUDE ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_PACKAGE ONLY)

set(CMAKE_C_FLAGS_INIT "-D__makos__")
set(CMAKE_CXX_FLAGS_INIT "-D__makos__")
set(CMAKE_ASM_FLAGS_INIT "-D__makos__")
list(PREPEND CMAKE_MODULE_PATH "${CMAKE_CURRENT_LIST_DIR}")
