From: MakOS Project <makos@localhost>
Subject: [PATCH] makos: report strict IPV6_V6ONLY socket policy

MakOS rejects IPv4-mapped IPv6 endpoints and has separate family transports.
Expose that fixed policy instead of rejecting Firefox's standard query/setup.

diff --git a/src/internal/makos_syscall.c b/src/internal/makos_syscall.c
--- a/src/internal/makos_syscall.c
+++ b/src/internal/makos_syscall.c
@@ -306,7 +306,14 @@ static long makos_getsockopt(long fd, long level, long option,
 {
 	long operation, result;
 	if (!value || !length || *length < sizeof(int)) return -EINVAL;
-	if (level != SOL_SOCKET) return -ENOPROTOOPT;
+	if (level == IPPROTO_IPV6 && option == IPV6_V6ONLY) {
+		result = makos_raw(M_fd_control, fd, 9, 0, 0, 0, 0);
+		if (result < 0) return result;
+		if (result != AF_INET6) return -ENOPROTOOPT;
+		*(int *)value = 1;
+		*length = sizeof(int);
+		return 0;
+	} else if (level != SOL_SOCKET) return -ENOPROTOOPT;
 	switch (option) {
 	case SO_TYPE: operation = 6; break;
 	case SO_ERROR: operation = 7; break;
@@ -331,5 +338,11 @@ static long makos_setsockopt(long fd, long level, long option,
 	memcpy(&setting, value, sizeof setting);
 	if (level == IPPROTO_TCP && option == TCP_NODELAY)
 		return makos_raw(M_fd_control, fd, 11, setting, 0, 0, 0);
+	if (level == IPPROTO_IPV6 && option == IPV6_V6ONLY) {
+		long domain = makos_raw(M_fd_control, fd, 9, 0, 0, 0, 0);
+		if (domain < 0) return domain;
+		if (domain != AF_INET6) return -ENOPROTOOPT;
+		return setting == 1 ? 0 : -ENOTSUP;
+	}
 	return -ENOPROTOOPT;
 }
