+static long makos_fixed_limit(long resource, struct rlimit *limit)
+{
+	if (!limit || resource < 0 || resource >= RLIMIT_NLIMITS) return -EINVAL;
+	limit->rlim_cur = RLIM_INFINITY;
+	limit->rlim_max = RLIM_INFINITY;
+	if (resource == RLIMIT_NOFILE || resource == RLIMIT_NPROC)
+		limit->rlim_cur = limit->rlim_max = 128;
+	else if (resource == RLIMIT_STACK)
+		limit->rlim_cur = limit->rlim_max = 64 * 1024 * 1024;
+	else if (resource == RLIMIT_CORE)
+		limit->rlim_cur = limit->rlim_max = 0;
+	return 0;
+}
+
+static long makos_prlimit(long pid, long resource,
+	const struct rlimit *requested, struct rlimit *previous)
+{
+	struct rlimit fixed;
+	long current = makos_raw(M_process_identity, 0, 0, 0, 0, 0, 0);
+	if (pid && pid != current) return -ESRCH;
+	if (makos_fixed_limit(resource, &fixed) < 0) return -EINVAL;
+	if (previous) *previous = fixed;
+	if (requested && (requested->rlim_cur != fixed.rlim_cur ||
+	    requested->rlim_max != fixed.rlim_max)) return -EPERM;
+	return 0;
+}
+
+static long makos_faccessat(long dirfd, const char *path, long mode)
+{
+	struct kstat value;
+	unsigned permission;
+	long uid, gid, result;
+	if (mode & ~(R_OK | W_OK | X_OK)) return -EINVAL;
+	result = makos_fstatat(dirfd, path, &value, 0);
+	if (result < 0 || mode == F_OK) return result;
+	uid = makos_raw(M_process_identity, 1, 0, 0, 0, 0, 0);
+	gid = makos_raw(M_process_identity, 2, 0, 0, 0, 0, 0);
+	if (!uid) {
+		if ((mode & X_OK) && !(value.st_mode & 0111)) return -EACCES;
+		return 0;
+	}
+	permission = value.st_mode & 7;
+	if ((unsigned)uid == value.st_uid) permission = value.st_mode >> 6 & 7;
+	else if ((unsigned)gid == value.st_gid) permission = value.st_mode >> 3 & 7;
+	if ((mode & R_OK) && !(permission & 4)) return -EACCES;
+	if ((mode & W_OK) && !(permission & 2)) return -EACCES;
+	if ((mode & X_OK) && !(permission & 1)) return -EACCES;
+	return 0;
+}
