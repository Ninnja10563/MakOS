+static long makos_getsockopt(long fd, long level, long option,
+	void *value, socklen_t *length)
+{
+	long operation, result;
+	if (!value || !length || *length < sizeof(int)) return -EINVAL;
+	if (level != SOL_SOCKET) return -ENOPROTOOPT;
+	switch (option) {
+	case SO_TYPE: operation = 6; break;
+	case SO_ERROR: operation = 7; break;
+	case SO_RCVBUF:
+	case SO_SNDBUF: operation = 8; break;
+	case SO_DOMAIN: operation = 9; break;
+	case SO_PROTOCOL: operation = 10; break;
+	default: return -ENOPROTOOPT;
+	}
+	result = makos_raw(M_fd_control, fd, operation, 0, 0, 0, 0);
+	if (result < 0) return result;
+	*(int *)value = result;
+	*length = sizeof(int);
+	return 0;
+}
+
+static long makos_setsockopt(long fd, long level, long option,
+	const void *value, socklen_t length)
+{
+	int setting;
+	if (!value || length < sizeof setting) return -EINVAL;
+	memcpy(&setting, value, sizeof setting);
+	if (level == IPPROTO_TCP && option == TCP_NODELAY)
+		return makos_raw(M_fd_control, fd, 11, setting, 0, 0, 0);
+	return -ENOPROTOOPT;
+}
