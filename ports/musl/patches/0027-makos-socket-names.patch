 	if (level == IPPROTO_TCP && option == TCP_NODELAY)
 		return makos_raw(M_fd_control, fd, 11, setting, 0, 0, 0);
 	return -ENOPROTOOPT;
+}
+
+static long makos_sockname(long fd, int peer, struct sockaddr *address,
+	socklen_t *length)
+{
+	struct sockaddr_in ipv4 = {0};
+	long packed;
+	if (!address || !length || *length < sizeof ipv4) return -EINVAL;
+	packed = makos_raw(M_fd_control, fd, peer ? 15 : 14, 0, 0, 0, 0);
+	if (packed < 0) return packed;
+	memcpy(&ipv4, &packed, 8);
+	memcpy(address, &ipv4, sizeof ipv4);
+	*length = sizeof ipv4;
+	return 0;
 }
 
