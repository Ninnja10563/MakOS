diff --git a/src/internal/makos_syscall.c b/src/internal/makos_syscall.c
new file mode 100644
index 0000000..4ec67df
--- /dev/null
+++ b/src/internal/makos_syscall.c
@@ -0,0 +1,292 @@
+/*
+ * MakOS AArch64 syscall translation for musl.
+ *
+ * musl's public syscall numbers remain the Linux AArch64 numbers used by its
+ * source.  This file is the only boundary that translates them to the
+ * independent MakOS ABI and normalizes MakOS's mixed return conventions.
+ */
+#include <errno.h>
+#include <fcntl.h>
+#include <sys/ioctl.h>
+#include <sys/mman.h>
+#include <termios.h>
+#include <time.h>
+#include "libc.h"
+
+enum linux_aarch64_syscall {
+	L_ioctl = 29,
+	L_unlinkat = 35,
+	L_renameat = 38,
+	L_openat = 56,
+	L_close = 57,
+	L_read = 63,
+	L_write = 64,
+	L_exit = 93,
+	L_exit_group = 94,
+	L_clock_gettime = 113,
+	L_sched_yield = 124,
+	L_rt_sigaction = 134,
+	L_setpgid = 154,
+	L_getpgid = 155,
+	L_socket = 198,
+	L_connect = 203,
+	L_sendto = 206,
+	L_recvfrom = 207,
+	L_brk = 214,
+	L_munmap = 215,
+	L_mmap = 222,
+	L_mprotect = 226,
+};
+
+enum makos_syscall {
+	M_yield = 1,
+	M_exit = 5,
+	M_open = 11,
+	M_read = 12,
+	M_close = 13,
+	M_write = 17,
+	M_clock_monotonic = 27,
+	M_create = 43,
+	M_unlink = 44,
+	M_socket = 47,
+	M_connect = 48,
+	M_send = 49,
+	M_receive = 50,
+	M_socket_close = 51,
+	M_mmap = 53,
+	M_munmap = 54,
+	M_mprotect = 55,
+	M_tcgetattr = 65,
+	M_tcsetattr = 66,
+	M_tcflush = 67,
+	M_ioctl = 68,
+	M_sigaction = 69,
+	M_getpgrp = 71,
+	M_setpgid = 72,
+	M_tcgetpgrp = 73,
+	M_tcsetpgrp = 74,
+	M_brk = 76,
+	M_rename = 77,
+};
+
+struct makos_termios {
+	unsigned input_flags;
+	unsigned output_flags;
+	unsigned control_flags;
+	unsigned local_flags;
+	unsigned char control_characters[32];
+	unsigned input_speed;
+	unsigned output_speed;
+};
+
+static long makos_raw(long n, long a, long b, long c, long d, long e, long f)
+{
+	register long x0 __asm__("x0") = a;
+	register long x1 __asm__("x1") = b;
+	register long x2 __asm__("x2") = c;
+	register long x3 __asm__("x3") = d;
+	register long x4 __asm__("x4") = e;
+	register long x5 __asm__("x5") = f;
+	register long x8 __asm__("x8") = n;
+	__asm__ __volatile__("svc 0" : "+r"(x0)
+		: "r"(x1), "r"(x2), "r"(x3), "r"(x4), "r"(x5), "r"(x8)
+		: "memory", "cc");
+	return x0;
+}
+
+static long path_length(const char *path)
+{
+	long length;
+	for (length = 0; length < 4096; length++)
+		if (!path[length]) return length;
+	return 4096;
+}
+
+static long makos_path_result(long result, int error)
+{
+	return result == -1 ? -error : result;
+}
+
+static long makos_bool_result(long result, int error)
+{
+	return result == 1 ? 0 : -error;
+}
+
+static void termios_from_makos(struct termios *to,
+	const struct makos_termios *from)
+{
+	int i;
+	to->c_iflag = from->input_flags;
+	to->c_oflag = from->output_flags;
+	to->c_cflag = from->control_flags | B38400;
+	to->c_lflag = from->local_flags;
+	to->c_line = 0;
+	for (i = 0; i < 32; i++) to->c_cc[i] = from->control_characters[i];
+	to->__c_ispeed = from->input_speed;
+	to->__c_ospeed = from->output_speed;
+}
+
+static void termios_to_makos(struct makos_termios *to,
+	const struct termios *from)
+{
+	int i;
+	to->input_flags = from->c_iflag;
+	to->output_flags = from->c_oflag;
+	to->control_flags = from->c_cflag;
+	to->local_flags = from->c_lflag;
+	for (i = 0; i < 32; i++) to->control_characters[i] = from->c_cc[i];
+	to->input_speed = 38400;
+	to->output_speed = 38400;
+}
+
+static long makos_openat(long dirfd, const char *path, long flags)
+{
+	long length, result;
+	int access;
+	/* O_LARGEFILE is a no-op on this 64-bit-only target. */
+	long supported = O_ACCMODE | O_CREAT | O_TRUNC | O_LARGEFILE;
+
+	if (dirfd != AT_FDCWD) return -ENOTSUP;
+	if (flags & ~supported) return -ENOTSUP;
+	access = flags & O_ACCMODE;
+	if (access == O_RDWR) return -ENOTSUP;
+	if (access == O_WRONLY && !(flags & O_TRUNC)) return -ENOTSUP;
+	if (access == O_RDONLY && (flags & O_TRUNC)) return -EINVAL;
+	length = path_length(path);
+	if (!length) return -ENOENT;
+	if (length >= 4096) return -ENAMETOOLONG;
+	if (flags & O_CREAT)
+		(void)makos_raw(M_create, (long)path, length, 0, 0, 0, 0);
+	result = makos_raw(M_open, (long)path, length, access == O_WRONLY,
+		0, 0, 0);
+	return makos_path_result(result, access == O_WRONLY ? EACCES : ENOENT);
+}
+
+static long makos_ioctl(long fd, long request, long argument)
+{
+	struct makos_termios value;
+	long result;
+
+	switch (request) {
+	case TCGETS:
+		result = makos_raw(M_tcgetattr, fd, (long)&value, sizeof value, 0, 0, 0);
+		if (result < 0) return result;
+		termios_from_makos((struct termios *)argument, &value);
+		return 0;
+	case TCSETS:
+	case TCSETSW:
+	case TCSETSF:
+		termios_to_makos(&value, (const struct termios *)argument);
+		return makos_raw(M_tcsetattr, fd, request - TCSETS,
+			(long)&value, sizeof value, 0, 0);
+	case TCFLSH:
+		return makos_raw(M_tcflush, fd, argument, 0, 0, 0, 0);
+	case TIOCGWINSZ:
+	case TIOCSWINSZ:
+		return makos_raw(M_ioctl, fd, request, argument, 8, 0, 0);
+	case TIOCGPGRP:
+		result = makos_raw(M_tcgetpgrp, fd, 0, 0, 0, 0, 0);
+		if (result < 0) return result;
+		*(int *)argument = result;
+		return 0;
+	case TIOCSPGRP:
+		return makos_raw(M_tcsetpgrp, fd, *(const int *)argument, 0, 0, 0, 0);
+	default:
+		return -ENOTTY;
+	}
+}
+
+hidden long __makos_syscall_dispatch(long n, long a, long b, long c,
+	long d, long e, long f)
+{
+	long length, result;
+
+	switch (n) {
+	case L_read:
+		result = makos_raw(M_read, a, b, c, 0, 0, 0);
+		return result == -1 ? -EBADF : result;
+	case L_write:
+		result = makos_raw(M_write, a, b, c, 0, 0, 0);
+		return result == -1 ? -EBADF : result;
+	case L_close:
+		result = makos_raw(M_close, a, 0, 0, 0, 0, 0);
+		if (result < 0) return result;
+		if (result == 1) return 0;
+		result = makos_raw(M_socket_close, a, 0, 0, 0, 0, 0);
+		return makos_bool_result(result, EBADF);
+	case L_openat:
+		return makos_openat(a, (const char *)b, c);
+	case L_unlinkat:
+		if (a != AT_FDCWD || c) return -ENOTSUP;
+		length = path_length((const char *)b);
+		if (!length) return -ENOENT;
+		if (length >= 4096) return -ENAMETOOLONG;
+		return makos_bool_result(makos_raw(M_unlink, b, length, 0, 0, 0, 0), ENOENT);
+	case L_renameat:
+		if (a != AT_FDCWD || c != AT_FDCWD) return -ENOTSUP;
+		length = path_length((const char *)b);
+		if (!length) return -ENOENT;
+		if (length >= 4096) return -ENAMETOOLONG;
+		result = path_length((const char *)d);
+		if (!result) return -ENOENT;
+		if (result > 255) return -ENAMETOOLONG;
+		return makos_bool_result(makos_raw(M_rename, b, length, d, result, 0, 0), ENOENT);
+	case L_ioctl:
+		return makos_ioctl(a, b, c);
+	case L_sched_yield:
+		return makos_raw(M_yield, 0, 0, 0, 0, 0, 0);
+	case L_clock_gettime:
+		if (a != CLOCK_MONOTONIC) return -ENOTSUP;
+		result = makos_raw(M_clock_monotonic, 0, 0, 0, 0, 0, 0);
+		((struct timespec *)b)->tv_sec = result / 100;
+		((struct timespec *)b)->tv_nsec = result % 100 * 10000000;
+		return 0;
+	case L_rt_sigaction:
+		if (d != 8) return -EINVAL;
+		return makos_raw(M_sigaction, a, b, c, 32, 0, 0);
+	case L_getpgid:
+		if (a) return -ENOTSUP;
+		return makos_raw(M_getpgrp, 0, 0, 0, 0, 0, 0);
+	case L_setpgid:
+		return makos_raw(M_setpgid, a, b, 0, 0, 0, 0);
+	case L_socket:
+		if (a != 2) return -EAFNOSUPPORT;
+		if (b != 1 && b != 2) return -ENOTSUP;
+		if (!c) c = b == 1 ? 6 : 17;
+		if ((b == 1 && c != 6) || (b == 2 && c != 17))
+			return -EPROTONOSUPPORT;
+		result = makos_raw(M_socket, a, b, c, 0, 0, 0);
+		return result == -1 ? -EAFNOSUPPORT : result;
+	case L_connect:
+		if (c < 8) return -EINVAL;
+		return makos_bool_result(makos_raw(M_connect, a, b, 8, 0, 0, 0), ECONNREFUSED);
+	case L_sendto:
+		if (d || e) return -ENOTSUP;
+		result = makos_raw(M_send, a, b, c, 0, 0, 0);
+		return result == -1 ? -EIO : result;
+	case L_recvfrom:
+		if (d || e) return -ENOTSUP;
+		result = makos_raw(M_receive, a, b, c, 0, 0, 0);
+		return result == -1 ? -EIO : result;
+	case L_mmap:
+		if (a || !b || d != (MAP_PRIVATE | MAP_ANONYMOUS) || e != -1 || f)
+			return -ENOTSUP;
+		result = makos_raw(M_mmap, b, c, 0, 0, 0, 0);
+		return result == -1 ? -ENOMEM : result;
+	case L_munmap:
+		return makos_bool_result(makos_raw(M_munmap, a, b, 0, 0, 0, 0), EINVAL);
+	case L_mprotect:
+		if (!(c & PROT_READ) || (c & ~(PROT_READ | PROT_WRITE | PROT_EXEC)))
+			return -ENOTSUP;
+		return makos_bool_result(makos_raw(M_mprotect, a, b, c, 0, 0, 0), EINVAL);
+	case L_brk:
+		result = makos_raw(M_brk, a, 0, 0, 0, 0, 0);
+		return result == -1 ? 0 : result;
+	case L_exit:
+	case L_exit_group:
+		makos_raw(M_exit, a, 0, 0, 0, 0, 0);
+		for (;;) __asm__ __volatile__("wfe");
+	default:
+		return -ENOSYS;
+	}
+}
