+static long makos_sleep_deadline(const struct timespec *request, int absolute)
+{
+	long ticks;
+	if (!request || request->tv_sec < 0 || request->tv_nsec < 0 ||
+	    request->tv_nsec >= 1000000000L || request->tv_sec > LONG_MAX / 100)
+		return -EINVAL;
+	ticks = request->tv_sec * 100 + (request->tv_nsec + 9999999L) / 10000000L;
+	if (!absolute) {
+		long now = makos_raw(M_clock_monotonic, 0, 0, 0, 0, 0, 0);
+		if (ticks > LONG_MAX - now) return -EINVAL;
+		ticks += now;
+	}
+	return makos_raw(M_sleep_until, ticks, 0, 0, 0, 0, 0);
+}
